{
  "name": "wn-client-launcher",
  "productName": "Cobalt Client",
  "version": "1.4.0",
  "description": "Cobalt Client - Minecraft 1.20.1 ~ 1.21.11 client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.wnsv.client",
    "productName": "Cobalt Client",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mods",
        "to": "mods",
        "filter": [
          "*.jar"
        ]
      }
    ],
    "artifactName": "Cobalt-Client-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cobalt Client",
      "runAfterFinish": true,
      "artifactName": "Cobalt-Client-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Cobalt-Client-Portable-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "winterkr0",
        "repo": "wn-client"
      }
    ]
  }
}
